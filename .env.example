# ==============================================================================
# mini-swe-mcp — environment configuration
# ==============================================================================
# Copy this file to `.env` and adjust the values, then run the server:
#
#     cp .env.example .env
#     cargo run --release -- --stdio
#
# `.env` files are auto-discovered, in this order of precedence (the first
# source that defines OPENAI_API_KEY wins):
#
#   1. `./.env` in the current directory (or the nearest ancestor directory)
#   2. `$XDG_CONFIG_HOME/mini-swe/.env` (usually `~/.config/mini-swe/.env`)
#   3. `.env` next to the executable, or one/two directories above it
#   4. The file pointed to by `ENV_FILE`
#
# Real environment variables always take precedence over any `.env` file.
# `.env` is git-ignored; never commit your real API key.
#
# Every optional *numeric* variable below is read through one helper: unset,
# blank and non-numeric values are all treated as "not set", so a typo falls
# back to the documented default instead of failing startup, and a value above
# a documented ceiling is clamped rather than rejected.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. OPENAI_API_BASE  (optional)
# ------------------------------------------------------------------------------
# Base URL of the OpenAI-compatible API endpoint. The trailing `/v1` is part of
# the URL and must be kept for standard OpenAI-compatible providers.
#
#   default: https://api.openai.com/v1
#
# Set this when routing requests through a gateway, proxy, or self-hosted
# runtime (vLLM, llama.cpp server, Ollama's OpenAI shim, LiteLLM, OpenRouter,
# or an internal "combo:" model gateway):
#
#   OPENAI_API_BASE=https://openrouter.ai/api/v1
#   OPENAI_API_BASE=http://127.0.0.1:8000/v1
OPENAI_API_BASE=https://api.openai.com/v1


# ------------------------------------------------------------------------------
# 2. OPENAI_API_KEY  (REQUIRED)
# ------------------------------------------------------------------------------
# Bearer token used to authenticate every request. The server refuses to start
# ("Missing OPENAI_API_KEY") if this variable is unset after all `.env` files
# have been loaded, so there is no built-in default.
#
# Any provider string is accepted — a real `sk-...` key, a gateway token, or a
# placeholder like `local` for servers that ignore authentication.
OPENAI_API_KEY=your_api_key_here


# ------------------------------------------------------------------------------
# 3. DEFAULT_MODEL  (optional)
# ------------------------------------------------------------------------------
# Model alias used for `dispatch` calls that do not pass an explicit `model`
# argument (e.g. `mini-swe-mcp dispatch "fix the flaky test"`).
#
#   default: ninja
#
# The value is a *manifest alias* from `models.yaml`, not a raw model id. It is
# resolved through the alias table first, then by matching an entry's `id`, and
# finally passed through verbatim (so a raw upstream id also works, but it then
# inherits no temperature/max_turns defaults).
#
# See `models.yaml` for the bundled aliases:
#
#   ninja  -> id `combo:ninja`  temp 0.2  max_turns 150  (repo exploration,
#                                                        tests, small fixes)
#   nerd   -> id `combo:nerd`   temp 0.6  max_turns 200  (root-cause
#                                                        debugging, refactors)
#
# (Those are the values in the bundled `models.yaml`; the built-in fallback
# catalog, used when no manifest file is found, declares max_turns 100 for
# both.)
#
# Run `mini-swe-mcp manifest` to print the active alias catalog.
DEFAULT_MODEL=ninja


# ------------------------------------------------------------------------------
# 4. MAX_CONCURRENT_WORKERS  (optional)
# ------------------------------------------------------------------------------
# Maximum number of subagents that may be *in flight* at the same time. Each
# dispatched worker holds a permit from this pool for its whole lifetime, so
# excess dispatches queue instead of starting.
#
#   default: 64
#
# Raise it to fan out more parallel work; lower it (e.g. 4-8) on small machines
# or when the upstream provider enforces strict per-key rate/concurrency limits.
# Non-numeric values are ignored and fall back to the default.
MAX_CONCURRENT_WORKERS=64


# ------------------------------------------------------------------------------
# 5. BASH_CONCURRENT_LIMIT  (optional)
# ------------------------------------------------------------------------------
# Maximum number of *bash commands* (builds, tests, greps) running at the same
# time across all workers. This is a second, stricter semaphore layered on top
# of MAX_CONCURRENT_WORKERS, so a large worker pool can never saturate the
# machine with parallel subprocesses.
#
#   default: MAX_CONCURRENT_WORKERS (one slot per worker)
#
# A worker runs one command at a time, so the default - one slot per worker -
# leaves this gate inert; set it lower to make a large pool share a tighter
# fleet-wide command budget. Heavy commands (cargo, make, pytest, compilers, ...)
# also take a slot from BASH_BUILD_LIMIT. Non-numeric values are ignored.
# BASH_CONCURRENT_LIMIT=4

# ----------
# 6. BASH_BUILD_LIMIT  (optional)
# ----------
# Maximum number of *heavy* commands running at the same time. "Heavy" is what
# `is_heavy_command` classifies: cargo, make, rustc, pytest/unittest, cmake,
# ninja, C/C++ compilers, npm/yarn/pnpm, mvn, gradle, `go test` / `go build`.
# Every other command takes only a BASH_CONCURRENT_LIMIT slot.
#
#   default: cores / 2  (std::thread::available_parallelism() / 2, min 1,
#                        falling back to 2 when the core count is unknown)
#
# This is what stops N concurrent workers from each launching a full build at
# the same time. Non-numeric values are ignored.
# Left unset so the `cores / 2` auto-detection stays in effect; uncomment and
# set a number to pin it (e.g. 8 on a 16-core host):
# BASH_BUILD_LIMIT=8


# ------------------------------------------------------------------------------
# 7. BUILD_PARALLELISM  (optional)
# ------------------------------------------------------------------------------
# Job/thread cap exported into every bash command that a worker runs. Keeping
# this at or below BASH_BUILD_LIMIT is what stops N concurrent builds from each
# spawning N own threads.
#
#   default: cores / 2  (the same host-cores / 2 derivation as BASH_BUILD_LIMIT)
#
# It is injected as the following environment variables for each command:
#
#   CARGO_BUILD_JOBS, RUST_TEST_THREADS, NEXTEST_TEST_THREADS,
#   MAKEFLAGS (-j<N>), CMAKE_BUILD_PARALLEL_LEVEL, RAYON_NUM_THREADS,
#   OMP_NUM_THREADS, OPENBLAS_NUM_THREADS, MKL_NUM_THREADS, GOMAXPROCS
#
# Because the cap is applied per command rather than per machine, keeping it
# modest is usually the right choice. Non-numeric values are ignored.
#
# Left unset so the `cores / 2` auto-detection stays in effect; uncomment and
# set a number to pin it (e.g. 8 on a 16-core host):
# BUILD_PARALLELISM=8


# ------------------------------------------------------------------------------
# 8. COMMAND_TIMEOUT_SECS  (optional)
# ------------------------------------------------------------------------------
# Hard wall-clock timeout, in seconds, for a single bash command. When the limit
# is hit the process group is terminated (SIGTERM, then SIGKILL) and the worker
# receives whatever the command printed, with exit code 124, so it can adapt
# its plan.
#
#   default: no override - 600 for a heavy command and 120 for a light one
#
# Setting it applies the same budget to every command; use
# COMMAND_HEAVY_TIMEOUT_SECS / COMMAND_LIGHT_TIMEOUT_SECS to tune one tier
# instead (this variable overrides both). Increase it for slow integration/CI
# suites; decrease it when subagents waste time on hanging commands.
# Non-numeric values are ignored and fall back to the tier default.
# Left unset so the heavy/light tier defaults above apply; uncomment and set a
# number to pin one budget for every command:
# COMMAND_TIMEOUT_SECS=600


# ------------------------------------------------------------------------------
# 9. MODELS_FILE  (optional)
# ------------------------------------------------------------------------------
# Absolute or relative path to a custom model manifest. Leave it unset to use
# the default lookup order below.
#
#   default: unset
#
# Search order when MODELS_FILE is not set (first existing file wins):
#
#   1. `./models.yaml` in the current working directory
#   2. `$XDG_CONFIG_HOME/mini-swe/models.yaml` (usually `~/.config/mini-swe/`)
#   3. `models.yaml` next to the executable
#   4. built-in manifest (aliases `ninja` and `nerd`)
#
# When the value is set it is tried *first*; if the file is missing or fails to
# parse, the search simply continues with the steps above. A manifest looks like:
#
#   default: ninja
#   models:
#     ninja:
#       id: combo:ninja
#       role: "Fast subagent for exploration, tests, and small fixes."
#       temperature: 0.2
#       max_turns: 50
#
# MODELS_FILE=/etc/mini-swe/models.yaml


# ==============================================================================
# ----------
# 10. WORKER_MAX_RETAINED_LOGS  (optional)
# ----------
# Number of step-log entries kept **per worker** in memory. The pool keeps a
# sliding window: once a worker exceeds the window its oldest entries are
# evicted and counted, so a worker's log memory is O(1) in the number of turns
# instead of growing for the lifetime of the process.
#
# Each entry stores a bounded command summary and a bounded output excerpt, so
# 200 entries is roughly 430 KiB per worker (27 MiB across a 64-worker fleet) no
# matter how many turns a worker runs.
#
#   default: 200
#   ceiling: 1000  (larger values are clamped)
#
# Lower it on memory-tight machines; raise it only if you need deeper histories
# and have RAM to spare. Zero and non-numeric values fall back to the default.
# WORKER_MAX_RETAINED_LOGS=200


# ----------
# 11. WORKER_MAX_EMITTED_LOGS  (optional)
# ----------
# Maximum number of step-log entries inlined into a *single* MCP response
# (`collect`, `dispatch --wait`, `logs`). Older retained entries are reported as
# `logs_omitted` together with a `logs_truncation_notice`, so a consumer can
# never mistake the tail for the full history.
#
# This bounds the per-request serialization spike independently of the
# retention window: 40 entries is roughly 85 KiB of log payload per response.
#
#   default: 40
#   ceiling: 500  (larger values are clamped)
#
# Zero and non-numeric values fall back to the default.
# WORKER_MAX_EMITTED_LOGS=40


# ----------
# 12. WORKER_TERMINAL_TTL_SECS  (optional)
# ----------
# How long a `Completed` or `Failed` worker record is kept in memory after it
# reaches that state. Without a TTL a finished worker pins its log window for
# the lifetime of the server, so residency would track the *historical* worker
# count rather than the concurrent one.
#
# Fresh terminal records are deliberately kept, so a `collect` (or a
# `dispatch --wait` that has just returned) still finds the worker. Once the TTL
# expires the record is dropped, both by the background reaper and lazily on the
# next `dispatch`.
#
# This TTL bounds memory only. The evicted record leaves its on-disk registry
# row and its saved conversation in place, so `steer` can still continue a
# finished worker hours later; those are governed by WORKER_RETENTION_SECS
# below, and by `prune` once the worker's branch is gone.
#
#   default: 300  (5 minutes)
#
# Raise it if your orchestrator collects workers slowly; lower it (e.g. 60) on
# long-lived servers that fan out many batches. Zero and non-numeric values
# fall back to the default.
# WORKER_TERMINAL_TTL_SECS=300


# ----------
# 13. WORKER_RETENTION_SECS  (optional)
# ----------
# How long a finished worker's registry row and saved conversation are kept
# after the worker reached its terminal state, even though its branch
# `worker-<id>` still exists. A week: long enough that an orchestrator
# reviewing, gating or merging days later can still `steer` the worker, short
# enough that a scratch root cannot grow without bound.
#
# The row and the conversation are removed *earlier* than this when the branch
# itself is gone -- merged and deleted, or reclaimed by `prune` -- because
# nothing can continue the worker then.
#
#   default: 604800  (7 days)
#
# Zero and non-numeric values fall back to the default.
# WORKER_RETENTION_SECS=604800


# ----------
# 14. Background jobs: JOB_MAX_SECS / WAIT_JOB_SECS  (optional)
# ----------
# A worker that starts a long build in the background (a `WAIT_JOB` handle)
# is bounded by two budgets, both in seconds and both read through the numeric
# helper above:
#
#   JOB_MAX_SECS    absolute ceiling on one background job's lifetime
#                   default: 2700  (45 minutes)
#   WAIT_JOB_SECS   how long one `wait` on a job blocks before it reports
#                   "still running" instead of holding the step open
#                   default: 600  (10 minutes)
#
# Past JOB_MAX_SECS the process group is killed whatever it is doing, so a
# wedged build cannot hold a worker forever. Lower JOB_MAX_SECS on a fleet
# that must never spend 45 minutes on one job; raise WAIT_JOB_SECS when your
# builds legitimately take longer than ten minutes to produce a first result
# (the job keeps running either way - the two budgets are independent).
# Zero and non-numeric values fall back to the defaults.
# JOB_MAX_SECS=2700
# WAIT_JOB_SECS=600

# ----------
# 15. Turn-budget extension: POOL_BUDGET_EXTENSION_PCT / _MAX  (optional)
# ----------
# When a worker reaches its `max_turns` budget while it is still making
# progress (a changed diff, or a test/gate command in the recent window, and no
# loop guard firing), it is granted exactly one automatic extension per
# revision. Its size is:
#
#   POOL_BUDGET_EXTENSION_PCT   percent of the dispatch's max_turns
#                               default: 25
#   POOL_BUDGET_EXTENSION_MAX   absolute cap on the extension, in turns
#                               default: 30
#
# i.e. `+25%`, capped at 30 turns. Set POOL_BUDGET_EXTENSION_PCT=0 (or
# POOL_BUDGET_EXTENSION_MAX=0) to disable the extension entirely and let a
# worker stop exactly at its budget. The extension is never granted twice in
# one revision, and never after a repetition/stagnation/read-only guard has
# fired in the same window - it is for a worker that is close, not one that is
# stuck. Zero and non-numeric values fall back to the defaults.
# POOL_BUDGET_EXTENSION_PCT=25
# POOL_BUDGET_EXTENSION_MAX=30

# ----------
# 16. Read-only guard: POOL_READ_ONLY_*_TURNS  (optional)
# ----------
# For a dispatch that names the files to edit, consecutive turns that change
# nothing on disk are counted. Three thresholds fire, each a turn count:
#
#   POOL_READ_ONLY_NUDGE_TURNS     first nudge: "write the edit you were asked
#                                  for instead of reading one more file"
#                                  default: 15
#   POOL_READ_ONLY_ESCALATE_TURNS  second nudge, which carries the edit plan
#                                  (the file and the identifiers named)
#                                  default: 30  (twice the first)
#   POOL_READ_ONLY_PAUSE_TURNS     third: the worker parks and asks the
#                                  orchestrator what to do
#                                  default: 45  (three times the first)
#
# The thresholds are independent: setting only the first leaves the other two
# at twice and three times *that* value, so raising the nudge to 30 also moves
# the escalation to 60 and the pause to 90. Unset, unparsable and zero values
# keep the corresponding default (zero is ignored, not honoured, so a typo
# cannot nudge a worker on its very first turn). A dispatch that names no file
# uses none of them - a worker still finding the code is exploring.
# POOL_READ_ONLY_NUDGE_TURNS=15
# POOL_READ_ONLY_ESCALATE_TURNS=30
# POOL_READ_ONLY_PAUSE_TURNS=45

# ----------
# 17. HUB_HANDOVER_SECS  (optional)
# ----------
# How long a hub handover waits for a quiet moment before it hands over
# anyway, in seconds. The daemon that just picked up a rebuilt executable
# (see HUB_AUTO_HANDOVER below) asks every live worker to checkpoint and stop;
# this is the budget for finding a moment where no command is running. It is
# the operator's default - a `hub/handover` request may name its own, clamped
# to the same bounds.
#
#   default: 900  (15 minutes)
#   range:   1 ..= 86400  (values outside are clamped)
#
# Raise it on a fleet whose commands are long (a big test suite can hold a
# slot for many minutes); lower it to pick up a new build promptly on a busy
# daemon. Non-numeric values fall back to the default.
# HUB_HANDOVER_SECS=900

# ----------
# 18. HUB_AUTO_HANDOVER  (optional)
# ----------
# Whether the hub watches its own executable for a rebuilt binary and hands
# over by itself. The watch re-stats the executable, and only when a *newer,
# complete* build has been sitting there stably does the daemon plan a
# handover: it waits for a quiet moment (HUB_HANDOVER_SECS), checkpoints and
# interrupts live workers, respawns from the executable path, and the new
# daemon auto-continues them.
#
#   default: enabled; set to 0 to disable
#
# `HUB_AUTO_HANDOVER=0` keeps the current daemon serving until a CLI call
# happens to arrive, which is what you want when the binary is rebuilt in
# place on a schedule you do not control, or when a handover mid-batch is
# worse than running the old build. Any value other than `0` leaves the watch
# on.
# HUB_AUTO_HANDOVER=1

# ----------
# 19. MINI_SWE_HUB_EXE_POLL_MS / MINI_SWE_HUB_EXE_STABLE_MS  (optional)
# ----------
# The two windows of that watch, in milliseconds:
#
#   MINI_SWE_HUB_EXE_POLL_MS    how often the daemon re-stats its own
#                               executable
#                               default: 2000
#   MINI_SWE_HUB_EXE_STABLE_MS  how long a changed executable must look
#                               identical (inode, size, mtime) before it
#                               counts as a finished build rather than a
#                               `cargo` write in progress
#                               default: 3000
#
# The defaults are chosen so the watch costs one stat every two seconds and
# cannot mistake a build in progress for a finished one. Lower both only if a
# rebuild is missed repeatedly (a long STABLE window delays the handover by
# that much on top of the poll interval); non-numeric values fall back to the
# defaults. Production normally leaves both unset.
# MINI_SWE_HUB_EXE_POLL_MS=2000
# MINI_SWE_HUB_EXE_STABLE_MS=3000

# ----------
# 20. MINI_SWE_RECONNECT_SECS  (optional)
# ----------
# How long a client follows a hub that keeps going away, in seconds. The
# budget covers the whole chase - a handover costs a handful of fast failures
# (no socket yet, lock still held, recovery running) - and it starts on the
# first failure and is never extended, so a watch cannot hold a decision open
# forever. When it runs out the command ends with an explanation instead of
# hanging.
#
#   default: 60
#   range:   1 ..= 86400  (values outside are clamped)
#
# Raise it when the replacement daemon needs longer to come up (a large pool
# reloading, a slow recovery); lower it to fail fast on a hub that is not
# coming back. Non-numeric values fall back to the default.
# MINI_SWE_RECONNECT_SECS=60

# ----------
# 21. MINI_SWE_TEARDOWN_WAIT_SECS  (optional)
# ----------
# How long the hub's shutdown waits for live workers' teardowns before it
# leaves their `.teardown` markers behind, in seconds. Without a bound a
# single stuck `git` in one worker's cleanup hangs the whole handover; the
# workers that miss this wait are waited on by the replacement hub through
# their markers, so raising it is safe but delays the handover.
#
#   default: 60
#
# The default is generous enough for a normal teardown. Raise it on slow
# filesystems with large worktrees, lower it when a handover must not wait on
# cleanup at all. Non-numeric values fall back to the default.
# MINI_SWE_TEARDOWN_WAIT_SECS=60

# ----------
# 22. HUB_HEAVY_IONICE  (optional)
# ----------
# The I/O scheduling class a *heavy* command's child is placed in. A saturated
# disk should slow the build down, not the light commands around it, so a
# heavy command is demoted and a light one is pinned to best-effort normal.
# This variable picks the demotion:
#
#   unset or any other value   best-effort, lowest level (the default)
#   0                          no demotion at all: the child keeps whatever
#                              class it inherited, demotion and pinning alike
#   idle  (or the class number 3)
#                              the idle class: the disk is used only when
#                              nothing else wants it
#
# Use `idle` for a fleet that must not disturb interactive work, and `0` to
# turn the feature off (for example on a filesystem where the `ionice` class
# makes no difference). The mechanism is `ioprio_set` in the child, falling
# back to an `ionice` wrapper on a host whose kernel does not implement the
# syscall; the setting has no effect on a light command either way.
# HUB_HEAVY_IONICE=idle

# ----------
# 23. WORKER_RETIRED_GRACE_SECS  (optional)
# ----------
# How long a finished worker's registry row and saved conversation are kept
# after its `worker-<id>` branch itself disappears, in seconds. A merged
# worker branch is pruned on the next dispatch, but an orchestrator may still
# revert that merge (a failing batch gate) and continue the worker, so its row
# and conversation outlive the branch for this long before the orphan sweep
# retires them.
#
#   default: 86400  (24 hours)
#
# Distinct from WORKER_RETENTION_SECS above, which is the budget for a worker
# whose branch still exists. Zero and non-numeric values fall back to the
# default, and a row with no recorded age is never treated as ancient.
# WORKER_RETIRED_GRACE_SECS=86400

# ----------
# 24. Per-agent cap: MAX_WORKERS_PER_AGENT  (optional)
# ----------
# Maximum number of workers a *single* agent identity may have running at the
# same time. A dispatch past the cap is refused, naming the workers already
# running so the orchestrator can collect one first. This is a fairness knob
# for a shared hub: it stops one busy orchestrator from consuming every permit
# in the pool and starving the others.
#
#   default: 0  (unlimited)
#
# Leave it unset when the pool is small or a single orchestrator owns it; set it
# (e.g. 8) on a shared hub where several agents dispatch concurrently.
# Non-numeric values fall back to the default.
# MAX_WORKERS_PER_AGENT=0

# ----------
# 25. Model-step outage patience: LLM_OUTAGE_PATIENCE_SECS  (optional)
# ----------
# `LLM_MAX_RETRIES` (documented below under "Additional optional variables")
# bounds the *attempt count* of one model step; this variable bounds how long
# an *outage* is tolerated before the worker gives up. A transient provider
# blip is ridden out for up to this many seconds, and only once the patience
# window is spent does the step fail, so a worker survives a brief outage
# rather than failing the task.
#
#   default: 600
#
# Raise it when your provider has long outages you would rather wait out;
# lower it when a fast failure beats a long wait. Non-numeric values fall back
# to the default.
# LLM_OUTAGE_PATIENCE_SECS=600

# ----------
# 26. Hub lifetime and recovery  (optional)
# ----------
#   HUB_AUTO_RESUME=0   do not continue interrupted workers when the hub
#                       restarts; every interrupted worker stays interrupted
#                       and only an explicit `steer <id> "..."` moves it.
#                       default: enabled (resume on restart)
#   HUB_IDLE_SECS       seconds an idle hub waits before exiting, so a hub
#                       started by a one-off command does not linger forever.
#                       default: 600
#   HUB_LLM_CONCURRENCY process-wide cap on in-flight LLM requests; 0 (the
#                       default) is unlimited. Set it when a provider enforces
#                       a per-key concurrency limit below what the worker pool
#                       would otherwise send.
#
# Set HUB_AUTO_RESUME=0 when workers must not resume unattended (for instance
# an orchestrator that always steers them deliberately). Non-numeric values
# fall back to the defaults.
# HUB_AUTO_RESUME=1
# HUB_IDLE_SECS=600
# HUB_LLM_CONCURRENCY=0

# ----------
# 27. Worker history compaction: HISTORY_FULL_TURNS / _BUDGET_BYTES /
#     HISTORY_KEEP_ALL_REASONING  (optional)
# ----------
# How much of a worker's conversation is replayed into its next model request.
# The older it gets, the more it is compacted; these bound what survives intact.
#
#   HISTORY_BUDGET_BYTES          byte budget for the retained history
#                                 default: 160000
#   HISTORY_FULL_TURNS            keep this many recent turns verbatim, which
#                                 overrides the byte budget
#                                 default: unset (the byte budget applies)
#   HISTORY_KEEP_ALL_REASONING=1  also keep the model's reasoning, not just its
#                                 prose and actions
#                                 default: unset (reasoning is elided)
#
# Lower HISTORY_BUDGET_BYTES to cut per-request token cost on long-running
# workers; raise it (or set HISTORY_FULL_TURNS) to give the model more verbatim
# context. HISTORY_KEEP_ALL_REASONING increases tokens noticeably, so enable it
# only for models whose reasoning you want carried forward.
# HISTORY_BUDGET_BYTES=160000
# HISTORY_FULL_TURNS=
# HISTORY_KEEP_ALL_REASONING=0

# ----------
# 28. SWE_HUB_DIR  (optional)
# ----------
# Directory holding the hub's socket and lock, and the watch tokens bound to
# each agent identity. The default is `<SWE_TEMP_DIR>/mini-swe-hub-<uid>`.
#
#   default: <SWE_TEMP_DIR>/mini-swe-hub-<uid>
#
# Point it elsewhere to isolate one hub from another on the same host (a
# per-project or per-tenant hub), which also isolates their worker pools. The
# directory is created mode 0700 when missing and refused when it exists but is
# not owned by this user or is group/world accessible, so do not point it at a
# shared path.
# SWE_HUB_DIR=/var/tmp/mini-swe-hub

# ----------
# 29. WORKER_SYNC_BASE=0  (optional)
# ----------
# Before reporting completion a worker syncs the base branch into its worktree
# so its diff is against the current base. Set `WORKER_SYNC_BASE=0` to disable
# that sync: the worker's branch is left exactly where it is, and any conflict
# with the base is left for you to resolve.
#
#   default: enabled (sync the base before completing)
#
# Disable it when the base is pinned for a round and a mid-flight sync would
# pull in changes the round is meant to exclude, or when a worktree's history
# must stay frozen for a diff review.
# WORKER_SYNC_BASE=1

# ----------
# 30. Admission control: HUB_MEM_RESERVE_MB / HUB_BUILD_MEM_MB / HUB_*_PRESSURE_MAX
# ----------
# The admission controller estimates how many heavy builds the machine can hold
# before load or pressure make them slower than running fewer. Its knobs, all
# read through the numeric helper:
#
#   HUB_MEM_RESERVE_MB        memory held back from the estimate per build slot
#                            default: 2048
#   HUB_BUILD_MEM_MB         estimated memory of one heavy command
#                            default: 1536
#   HUB_CPU_PRESSURE_MAX     CPU `some avg10` ceiling, in percent
#                            default: 60
#   HUB_MEM_PRESSURE_MAX     memory `full avg10` ceiling, in percent
#                            default: 10
#   HUB_IO_PRESSURE_MAX      IO `full avg10` ceiling, in percent
#                            default: 40
#
# Raise the pressure ceilings to let more heavy commands run at once on a host
# that tolerates higher load; lower them on a box that shares other work. The
# memory values tune the reservation per build. Zero and non-numeric values
# fall back to the defaults.
# HUB_MEM_RESERVE_MB=2048
# HUB_BUILD_MEM_MB=1536
# HUB_CPU_PRESSURE_MAX=60
# HUB_MEM_PRESSURE_MAX=10
# HUB_IO_PRESSURE_MAX=40

# ----------
# 31. Build target slots: MINI_SWE_TARGET_SLOT_MAX_GIB / HUB_TARGET_TTL_HOURS
#     / HUB_TARGET_MAX_GB  (optional)
# ----------
# Cargo never deletes a superseded artifact set: every rustc, dependency or flag
# change and every renamed test target leaves a full extra set behind, so a slot
# that stays in one repository's pool for weeks grows without bound (39 GiB
# across six slots was measured on one host). Three numbers bound them:
#
#   MINI_SWE_TARGET_SLOT_MAX_GIB
#                          size one leased slot may hold before it is emptied
#                          and handed to the next worker, 0 disables the cap
#                          default: 4
#   HUB_TARGET_TTL_HOURS   how old a target dir may be before it is swept
#                          default: 24
#   HUB_TARGET_MAX_GB      total size the swept set may reach before the oldest
#                          dirs are dropped first
#                          default: 40
#
# Only an idle slot is ever emptied, and only the one a worker has just leased:
# a slot another worker holds is never touched. The cost is one rebuild of your
# crate, because the compiler cache restores the third-party dependencies. Lower
# the TTL to reclaim disk faster on a small host; lower the cap to bound the
# build cache footprint. Zero and non-numeric values fall back to the defaults
# (`MINI_SWE_TARGET_SLOT_MAX_GIB=0` is the exception: it disables the cap).
# MINI_SWE_TARGET_SLOT_MAX_GIB=4
# HUB_TARGET_TTL_HOURS=24
# HUB_TARGET_MAX_GB=40

# ----------
# 32. kache probe: KACHE_CACHE_EXECUTABLES  (optional)
# ----------
# Extra comma-separated executable names the `kache` compiler-cache probe keeps,
# alongside the built-in set, so a cache probe recognises a non-standard
# toolchain. Missing names are ignored; the value is split on commas and
# trimmed.
# KACHE_CACHE_EXECUTABLES=

# ----------
# 33. MINI_SWE_AGENT_ID  (optional)
# ----------
# Pins the session's agent identity. Every dispatch and steer carries its
# caller's identity so each orchestrator sees only its own workers (the
# operator's `--admin` overrides this); setting MINI_SWE_AGENT_ID makes a
# process act as that identity instead of deriving one from the socket's
# peer credentials, which is how a watch command is attributed to the session
# that started it.
#   default: derived from the connecting socket (SO_PEERCRED)
# MINI_SWE_AGENT_ID=

# ----------
# 34. MINI_SWE_WATCH_TOKEN  (optional)
# ----------
# An unguessable token bound to one agent identity, returned by a dispatch or
# steer answer so the `watch` its shell runs is exactly that identity rather
# than the bare host. A watch presents the token in `hub/hello`; presenting
# none falls back to the host identity. The token is generated by the hub and
# never reused, so a value set here is only honoured against the identity that
# issued it.
# MINI_SWE_WATCH_TOKEN=

# ----------
# 35. MINI_SWE_NO_DAEMON=1  (optional)
# ----------
# Serve MCP in-process instead of through the hub daemon. The CLI and `--stdio`
# are normally thin front ends that start (or join) the shared hub; setting
# MINI_SWE_NO_DAEMON=1 makes the process own its own worker pool and skip the
# hub socket entirely, which is what a single-shot, single-client invocation
# wants. Any value other than `1` leaves the hub path on.
# MINI_SWE_NO_DAEMON=1

# ----------
# 36. Sandbox backend: SWE_SANDBOX  (optional)
# ----------
# Forces the sandbox backend for every worker command. The daemon normally
# picks bubblewrap when it is installed, then the kernel (Landlock + seccomp)
# otherwise. Setting SWE_SANDBOX=bwrap forces the bubblewrap namespace
# backend; setting it to anything else (or leaving it unset) lets the daemon
# choose. Only consulted when bubblewrap is installed, so it cannot force a
# backend the host cannot provide.
# SWE_SANDBOX=bwrap

# ----------
# 37. Landlock enforcement: MINI_SWE_LANDLOCK_ENFORCE  (optional)
# ----------
# When set, the kernel backend runs an end-to-end Landlock enforcement check in
# a dedicated child process before serving workers, so a host whose kernel
# silently refuses the restriction is caught at startup rather than mid-run.
# Any non-empty value enables the check; unset leaves the lazy (per-command)
# enforcement in place.
# MINI_SWE_LANDLOCK_ENFORCE=1

# ----------
# 38. SWE_ALLOW_TOOLCHAIN_CREDENTIALS=1  (optional)
# ----------
# The toolchain cache directories (kache, uv, pip, node, go) are writable in
# the sandbox because builds must populate them, but the credential files
# beside them - an npm token, a Maven `settings.xml` password - are never
# granted. Set SWE_ALLOW_TOOLCHAIN_CREDENTIALS=1 to expose those credential
# files to the sandbox; only do so for a host whose caches you trust every
# worker to read. Any value other than `1` keeps them unreadable.
# SWE_ALLOW_TOOLCHAIN_CREDENTIALS=1

# ----------
# 39. WORKER_DIVERGENT_VERIFY=0  (optional)
# ----------
# A verify gate that only passes in the sandbox proves the suite is hermetic
# against the sandbox, not against the shell it is later verified in. When the
# gate passes in the canonical environment the same command runs once more in a
# divergent one (the dispatcher's ambient variables filtered of secrets, a fresh
# HOME and TMPDIR, and a TZ shifted far from the host's). Set
# WORKER_DIVERGENT_VERIFY=0 to turn the second run off; any other value leaves
# it on.
# WORKER_DIVERGENT_VERIFY=1

# Additional optional variables
# ==============================================================================

# --- ENV_FILE ----------------------------------------------------------------
# Explicit path to an alternative `.env` file. Only consulted when
# OPENAI_API_KEY is still missing after the CWD, XDG, and executable-relative
# lookups, so it acts as a last-resort override.
# ENV_FILE=/etc/mini-swe/credentials.env

# --- XDG_CONFIG_HOME ---------------------------------------------------------
# Base directory for the XDG lookup paths above. Falls back to `$HOME/.config`
# when unset, which is where `~/.config/mini-swe/{.env,models.yaml}` live.
# XDG_CONFIG_HOME=/home/user/.config

# --- RUST_LOG ----------------------------------------------------------------
# tracing-subscriber filter, e.g. `debug`, `mini_swe_mcp=debug`, or
# `mini_swe_mcp::pool=trace`. Defaults to `warn` in stdio mode (`--stdio`) and
# `info` for the CLI, so an MCP channel is never flooded; the server prints its
# structured logs to stderr so the stdio JSON-RPC channel on stdout stays clean.
# RUST_LOG=info

# --- COMMAND_HEAVY_TIMEOUT_SECS / COMMAND_LIGHT_TIMEOUT_SECS  (optional) ---
# Per-tier command budgets, used only when COMMAND_TIMEOUT_SECS is unset:
# 600s for a heavy command, 120s for a light one.
# COMMAND_HEAVY_TIMEOUT_SECS=600
# COMMAND_LIGHT_TIMEOUT_SECS=120

# --- LLM_MAX_RETRIES  (optional) ---
# Attempts for one LLM step before the worker is treated as failed; retries use
# exponential backoff with a cap. The related `LLM_OUTAGE_PATIENCE_SECS`
# (section 25) bounds how long an outage is tolerated. Non-numeric values are
# ignored.
#   default: 6
# LLM_MAX_RETRIES=6

# --- MINI_SWE_WORKER_THREADS  (optional) ---
# tokio worker threads for the server runtime. Non-numeric or non-positive
# values are ignored. A value exported in the real environment wins over one
# read from a `.env` file.
# MINI_SWE_WORKER_THREADS=8

# --- SWE_TEMP_DIR  (optional) ---
# Root for all worker scratch data: worktrees, per-worker target dirs, the
# shared cache root and the steering mailboxes. Defaults to `/var/tmp` when it
# exists, else the system temp dir.
# SWE_TEMP_DIR=/var/tmp

# --- SWE_CACHE_DIR  (optional) ---
# Root of the shared toolchain caches (kache, uv, pip, node, go) that are
# bind-mounted into every worker. Defaults to `<SWE_TEMP_DIR>/swe-cache`.
# SWE_CACHE_DIR=/var/tmp/swe-cache

# --- SWE_SHARED_CACHES  (optional) ---
# Extra `host:guest` cache binds added to the worker sandbox, comma separated
# (e.g. `/mnt/toolchains:/mnt/toolchains`). Missing directories are created.
# SWE_SHARED_CACHES=/mnt/toolchains:/mnt/toolchains

# --- CARGO_TARGET_DIR  (optional) ---
# Build output directory for every worker. When unset, each worker builds into
# its own `<SWE_TEMP_DIR>/swe-target-swe-wt-<id>` so concurrent workers never
# share a build cache; setting it trades that isolation for a shared cache.
# CARGO_TARGET_DIR=/var/tmp/swe-target

# --- WORKER_BUILD_DEBUG  (optional) ---
# A worker's private target directory is rebuilt from scratch far more often
# than it is reused, so Cargo's debug info and incremental state are trimmed by
# default (through CARGO_PROFILE_DEV_DEBUG, CARGO_PROFILE_TEST_DEBUG and
# CARGO_INCREMENTAL). Set `1` to keep Cargo's own defaults - full debug info
# and incremental compilation - at the cost of a much larger target directory.
# A value the operator already exported for those names wins either way.
#   default: unset (trimmed)
# WORKER_BUILD_DEBUG=1

# --- SWE_DISABLE_SANDBOX  (optional) ---
# Set to `1` to skip the bubblewrap mount namespace. Only consulted when
# bubblewrap is installed; the command then runs under Landlock confinement
# instead of bwrap.
# SWE_DISABLE_SANDBOX=1

# --- SWE_DISABLE_LANDLOCK  (optional) ---
# Set to `1` to skip Landlock confinement when bubblewrap is unavailable. The
# command then runs unconfined (only the command guard applies) rather than
# failing; the skip is logged at debug level.
# SWE_DISABLE_LANDLOCK=1

# --- SWE_DISABLE_KACHE / KACHE_DISABLED  (optional) ---
# Set either to `1` to skip the `kache` compiler-cache probe and binds.
# SWE_DISABLE_KACHE=1
# KACHE_DISABLED=1

# --- MONITOR_WIDTH  (optional) ---
# Column width for the `monitor` / `supervisor` views when the real terminal
# size cannot be detected. Non-positive values are ignored; the built-in
# fallback is 80.
# MONITOR_WIDTH=80

# --- NO_COLOR  (optional) ---
# Set to any value to disable ANSI colour in the `monitor` / `supervisor`
# views, even on a TTY. Colours are off by default when the output is not a
# terminal.
# NO_COLOR=1
