{
  "tools": [
    {
      "description": "Git-worktree workers. Parallel work is a ROUND: dispatch tasks+group+consolidate, cheap per-worker gate, wait with watch --group <g> --all (MCP all:true), read the consolidator's report, merge it. mini-swe-mcp watch: run it again after each event. MCP watch: timeout_secs. Only own workers; admin excepted. Topics: `help <topic>` (CLI) or action 'help' (MCP).",
      "inputSchema": {
        "properties": {
          "action": {
            "description": "The verb; the enum lists every one.",
            "enum": [
              "dispatch",
              "status",
              "steer",
              "watch",
              "collect",
              "review",
              "approve",
              "unapprove",
              "logs",
              "list",
              "kill",
              "reap",
              "manifest",
              "prune",
              "merge",
              "consolidate",
              "help"
            ],
            "type": "string"
          },
          "all": {
            "description": "The whole round as one event.",
            "type": "boolean"
          },
          "approved": {
            "description": "Merge every approved worker.",
            "type": "boolean"
          },
          "consolidate": {
            "description": "Auto-consolidate stopped group: true uses strongest/default; string pins model.",
            "type": [
              "boolean",
              "string"
            ]
          },
          "consolidate_verify": {
            "description": "Consolidator's full gate; default: auto-detect.",
            "type": "string"
          },
          "diff": {
            "default": "code",
            "description": "Diff scope for 'review': 'code' (default) hides tests, 'all' all, 'none' none.",
            "enum": [
              "code",
              "all",
              "none"
            ],
            "type": "string"
          },
          "files": {
            "description": "Paths whose diff 'collect' returns.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "full": {
            "description": "The whole diff for 'collect'.",
            "type": "boolean"
          },
          "group": {
            "description": "Workers of this group (watch, merge --approved).",
            "type": "string"
          },
          "id": {
            "description": "Alias for worker_id",
            "type": "string"
          },
          "keep_branch": {
            "description": "Keep the branch.",
            "type": "boolean"
          },
          "max_turns": {
            "description": "Max bash turns (overrides default); on 'steer', the budget continuing a stopped worker.",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "message": {
            "description": "Required for steer: resumes own branch with full context, stopped included; never dispatch a replacement. max_turns sets budget.",
            "type": "string"
          },
          "model": {
            "description": "Available model aliases and their roles:\n- `nerd` (id: `combo:nerd`): Deep reasoner: hard debugging, complex architecture, multi-file refactors.\n- `ninja` (id: `combo:ninja`): Fast executor: exploration, test runs, syntax fixes, focused edits.\n",
            "type": "string"
          },
          "network": {
            "default": "allow",
            "description": "Network: 'offline' isolates every step (no egress); 'allow' (default) keeps connectivity.",
            "enum": [
              "offline",
              "allow"
            ],
            "type": "string"
          },
          "path": {
            "description": "Alias for repo_path",
            "type": "string"
          },
          "repo_path": {
            "description": "Repository root (alias: 'path'). Required for 'dispatch'.",
            "type": "string"
          },
          "review_after": {
            "description": "Reviewer model for the worktree audit.",
            "type": "string"
          },
          "role": {
            "description": "'consolidate': integrate this group's completed workers (requires 'group')",
            "type": "string"
          },
          "scope": {
            "default": "mine",
            "description": "'list' scope: 'mine' (default) or 'all' (admin).",
            "enum": [
              "mine",
              "all"
            ],
            "type": "string"
          },
          "task": {
            "description": "ONE focused concern: files in scope, acceptance gate.",
            "type": "string"
          },
          "tasks": {
            "description": "Batch {task, model?, ...}; top-level defaults.",
            "items": {
              "properties": {
                "consolidate": {
                  "type": [
                    "boolean",
                    "string"
                  ]
                },
                "consolidate_verify": {
                  "type": "string"
                },
                "group": {
                  "type": "string"
                },
                "max_turns": {
                  "type": "integer"
                },
                "model": {
                  "type": "string"
                },
                "network": {
                  "type": "string"
                },
                "repo_path": {
                  "type": "string"
                },
                "task": {
                  "type": "string"
                },
                "verify": {
                  "type": "string"
                }
              },
              "required": [
                "task"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "temperature": {
            "description": "Model temperature (overrides default).",
            "maximum": 2.0,
            "minimum": 0.0,
            "type": "number"
          },
          "timeout_secs": {
            "description": "Watch deadline secs; expiry: no_event.",
            "minimum": 0,
            "type": "integer"
          },
          "topic": {
            "description": "Help topic; omitted: the index",
            "type": "string"
          },
          "verify": {
            "description": "Completion gate: auto-detect if omitted; empty disables. Cheap for workers, full for consolidator.",
            "type": "string"
          },
          "worker_id": {
            "description": "Target worker (alias 'id'): 3+ char prefix or 'last'; required by targeting verbs.",
            "type": "string"
          },
          "worker_ids": {
            "description": "Worker IDs to watch (prefixes like 'worker_id'). Omitted: your own workers.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "worker"
    }
  ]
}